+    '/bin',
+    '/sbin',
+    '/lib',
+    '/lib64',
+    '/lib32',
+    '/libx32',
+    '/opt',
+    '/dev',
+    '/proc',
+    '/sys',
+    '/boot',
+    '/srv',
+    '/private/tmp',
+    '/private/var',
+    '/Users',
+    '/Applications',
+    '/System',
+    '/Library',
+    '/Volumes',
