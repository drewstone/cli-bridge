+      return
+    }
+    if (!stat.isFile()) throw new Error(`${label} contains a special file: ${current}`)
+    entries.push({ path: current, device: String(stat.dev), inode: String(stat.ino), kind: 'file' })
+  }
+  visit(path)
+  return entries
+}
