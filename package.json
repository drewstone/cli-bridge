{
  "name": "@tangle-network/cli-bridge",
  "version": "0.2.0",
  "description": "Expose your local coding-CLI subscriptions (Claude Code, Codex, Kimi via opencode, …) as an OpenAI-compatible HTTP API with persistent session resume. Personal tool — single-user by default.",
  "type": "module",
  "license": "MIT",
  "files": ["dist", "README.md", "LICENSE"],
  "bin": {
    "cli-bridge": "dist/cli.js"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/cli.js",
    "build": "tsc -p tsconfig.build.json && node scripts/set-cli-mode.mjs",
    "prepack": "tsc -p tsconfig.build.json && node scripts/set-cli-mode.mjs",
    "release:check": "pnpm build && node scripts/check-package.mjs && pnpm source-install:check",
    "install:check": "node scripts/check-installed-cli.mjs",
    "source-install:check": "node scripts/check-source-install.mjs",
    "test": "vitest run",
    "test:scoped-host-real": "CLI_BRIDGE_REAL_CGROUP_TESTS=1 vitest run tests/scoped-host.test.ts",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "review": "~/code/dotfiles/bin/ai-agent-hooks.mjs run review",
    "verify": "tsx scripts/verify.ts",
    "verify:fs-jail": "tsx scripts/verify-fs-jail.ts",
    "install:harness": "sh scripts/install-harness.sh",
    "install:harnesses": "sh scripts/install-all-harnesses.sh",
    "docker:build:runtime": "docker build -f docker/Dockerfile.cli-runtime -t cli-bridge-cli-runtime:latest ."
  },
  "dependencies": {
    "@hono/node-server": "^1.13.0",
    "@tangle-network/agent-interface": "0.43.0",
    "@tangle-network/agent-profile-materialize": "0.10.2",
    "@tangle-network/agent-trace-contract": "^1.0.2",
    "better-sqlite3": "^12.0.0",
    "hono": "^4.9.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.0.0"
  }
}
