@@ -101,6 +188,154 @@ export class SessionStore {
     }
   }
 
+  /**
+   * Reserve the native prompt ordinal at controller admission, before execution.
+   *
+   * Existing session.turns anchors migrations whose earlier native prompts predate
+   * receipts. The separate approval row also keeps concurrent completions ordered by
+   * admission rather than whichever provider happens to finish first.
+   */
+  approveProviderTurn(
+    externalId: string,
+    backend: string,
+    runId: string,
+  ): number {
+    return this.db.transaction(() => {
+      const prior = this.db.prepare(
+        `SELECT ordinal FROM provider_turn_approvals
+         WHERE external_id = ? AND backend = ? AND run_id = ?`,
+      ).get(externalId, backend, runId) as { ordinal: number } | undefined
+      if (prior) return prior.ordinal
+      const approved = this.db.prepare(
+        `SELECT MAX(ordinal) AS ordinal FROM provider_turn_approvals
+         WHERE external_id = ? AND backend = ?`,
+      ).get(externalId, backend) as { ordinal: number | null }
+      const session = this.db.prepare(
+        'SELECT turns FROM sessions WHERE external_id = ? AND backend = ?',
+      ).get(externalId, backend) as { turns: number } | undefined
+      const ordinal = Math.max(approved.ordinal ?? 0, session?.turns ?? 0) + 1
+      this.db.prepare(
+        `INSERT INTO provider_turn_approvals (external_id, backend, run_id, ordinal)
+         VALUES (?, ?, ?, ?)`,
+      ).run(externalId, backend, runId, ordinal)
+      return ordinal
+    })()
+  }
+
+  /**
+   * Commit one terminal provider request exactly once.
+   *
+   * The ordinal counts every native prompt, including multipart prompts whose exact
+   * user bytes are unavailable. Those turns remain internal and are deliberately
+   * absent from the public controller-turn receipts.
+   */
+  recordProviderTurn(args: {
+    externalId: string
+    backend: string
+    internalId: string
+    cwd: string
+    runId: string
+    ordinal: number
+    bridgeRequestDigest: string
+    promptSha256?: `sha256:${string}`
+    startedAt: number
+    endedAt: number
+  }): ExactSessionRecord {
+    return this.db.transaction(() => {
+      const row = this.db.prepare(
+        'SELECT * FROM sessions WHERE external_id = ? AND backend = ?',
+      ).get(args.externalId, args.backend) as Record<string, unknown> | undefined
+      const existing = row ? this.hydrate(row) : null
+      const turns = row ? this.hydrateProviderTurns(row.provider_turns_json) : []
+      const prior = turns.find((turn) => turn.runId === args.runId)
+      const approval = this.db.prepare(
+        `SELECT ordinal FROM provider_turn_approvals
+         WHERE external_id = ? AND backend = ? AND run_id = ?`,
+      ).get(args.externalId, args.backend, args.runId) as { ordinal: number } | undefined
+      if (!approval || approval.ordinal !== args.ordinal) {
+        throw new Error(
+          `provider run ${JSON.stringify(args.runId)} has no matching approved native prompt ordinal`,
+        )
+      }
+      const expected = {
+        runId: args.runId,
+        bridgeRequestDigest: args.bridgeRequestDigest,
+        ...(args.promptSha256 ? { promptSha256: args.promptSha256 } : {}),
+        startedAt: args.startedAt,
+        endedAt: args.endedAt,
+      }
+      if (prior) {
+        const { ordinal, ...material } = prior
+        if (ordinal !== args.ordinal) {
+          throw new Error(
+            `provider run ${JSON.stringify(args.runId)} changed its native prompt ordinal`,
+          )
+        }
+        if (JSON.stringify(material) !== JSON.stringify(expected)) {
+          throw new Error(
+            `provider run ${JSON.stringify(args.runId)} is already bound to a different terminal receipt`,
+          )
+        }
+        if (
+          existing?.internalId !== args.internalId
+          || existing.cwd !== args.cwd
+        ) {
+          throw new Error(
+            `provider run ${JSON.stringify(args.runId)} changed its native session identity`,
+          )
+        }
+        return this.exactRecord(
+          existing,
+          turns,
+          this.approvedPromptCount(args.externalId, args.backend),
+        )
+      }
+
+      const providerTurn: StoredProviderTurn = { ordinal: args.ordinal, ...expected }
+      const nextTurns = [...turns, providerTurn].sort((left, right) => left.ordinal - right.ordinal)
+      const now = Date.now()
+      const createdAt = existing?.createdAt ?? now
+      const metadata = existing?.metadata ?? {}
+      // `upsert` already advances the public session turn count. Keep that historical
+      // counter intact when adding the separate terminal-receipt ledger, including for
+      // databases created before provider receipts existed.
+      const sessionTurns = existing?.turns ?? nextTurns.length
+      this.db.prepare(
+        `INSERT INTO sessions (
+           external_id, backend, internal_id, cwd, turns, created_at, last_used_at,
+           metadata_json, provider_turns_json
+         )
+         VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?)
+         ON CONFLICT(external_id, backend) DO UPDATE SET
+           internal_id = excluded.internal_id,
+           cwd = excluded.cwd,
+           turns = excluded.turns,
+           last_used_at = excluded.last_used_at,
+           provider_turns_json = excluded.provider_turns_json`,
+      ).run(
+        args.externalId,
+        args.backend,
+        args.internalId,
+        args.cwd,
+        sessionTurns,
+        createdAt,
+        now,
+        JSON.stringify(metadata),
+        JSON.stringify(nextTurns),
+      )
+      return this.exactRecord({
+        externalId: args.externalId,
+        backend: args.backend,
+        internalId: args.internalId,
+        cwd: args.cwd,
+        turns: sessionTurns,
+        createdAt,
+        lastUsedAt: now,
+        metadata,
+      }, nextTurns, this.approvedPromptCount(args.externalId, args.backend))
+    })()
+  }
+
   list(limit = 100): SessionRecord[] {
     const rows = this.db.prepare(
       'SELECT * FROM sessions ORDER BY last_used_at DESC LIMIT ?',
@@ -135,4 +370,66 @@ export class SessionStore {
       metadata: JSON.parse((row.metadata_json as string) || '{}'),
     }
   }
+
+  private providerTurns(externalId: string, backend: string): StoredProviderTurn[] {
+    const row = this.db.prepare(
+      'SELECT provider_turns_json FROM sessions WHERE external_id = ? AND backend = ?',
+    ).get(externalId, backend) as { provider_turns_json?: unknown } | undefined
+    return this.hydrateProviderTurns(row?.provider_turns_json)
+  }
+
+  private approvedPromptCount(externalId: string, backend: string): number {
+    const approved = this.db.prepare(
+      `SELECT MAX(ordinal) AS ordinal FROM provider_turn_approvals
+       WHERE external_id = ? AND backend = ?`,
+    ).get(externalId, backend) as { ordinal: number | null }
+    const session = this.db.prepare(
+      'SELECT turns FROM sessions WHERE external_id = ? AND backend = ?',
+    ).get(externalId, backend) as { turns: number } | undefined
+    return Math.max(approved.ordinal ?? 0, session?.turns ?? 0)
+  }
+
+  private hydrateProviderTurns(value: unknown): StoredProviderTurn[] {
+    const parsed: unknown = JSON.parse(typeof value === 'string' ? value : '[]')
+    if (!Array.isArray(parsed)) {
+      throw new Error('session provider-turn ledger is malformed')
+    }
+    return parsed as StoredProviderTurn[]
+  }
+
+  private exactRecord(
+    session: SessionRecord,
+    turns: StoredProviderTurn[],
+    nativePromptCount: number,
+  ): ExactSessionRecord {
+    if (!session.cwd) {
+      throw new Error(
+        `session ${JSON.stringify(session.externalId)} has no exact working directory`,
+      )
+    }
+    if (nativePromptCount <= 0) {
+      throw new Error(
+        `session ${JSON.stringify(session.externalId)} has no approved native prompts`,
+      )
+    }
+    return {
+      externalId: session.externalId,
+      backend: session.backend,
+      internalId: session.internalId,
+      cwd: session.cwd,
+      nativePromptCount,
+      controllerTurns: turns.flatMap((turn) =>
+        turn.promptSha256
+          ? [{
+              ordinal: turn.ordinal,
+              runId: turn.runId,
+              bridgeRequestDigest: turn.bridgeRequestDigest,
+              promptSha256: turn.promptSha256,
+              startedAt: turn.startedAt,
+              endedAt: turn.endedAt,
+            }]
+          : [],
+      ),
+    }
+  }
 }
