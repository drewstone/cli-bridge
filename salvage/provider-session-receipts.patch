+export interface ControllerTurnReceipt {
+  /** One-based native provider prompt ordinal within this external session. */
+  ordinal: number
+  runId: string
+  bridgeRequestDigest: string
+  promptSha256: `sha256:${string}`
+  /** Provider request interval as Unix milliseconds. */
+  startedAt: number
+  /** Provider request interval as Unix milliseconds. */
+  endedAt: number
+}
+
+export interface ExactSessionRecord {
+  externalId: string
+  backend: string
+  internalId: string
+  cwd: string
+  nativePromptCount: number
+  controllerTurns: ControllerTurnReceipt[]
+}
+
+export type ExactSessionLookup =
+  | { status: 'found'; session: ExactSessionRecord }
+  | { status: 'not-found' }
+  | { status: 'ambiguous' }
+
+interface StoredProviderTurn {
+  ordinal: number
+  runId: string
+  bridgeRequestDigest: string
+  promptSha256?: `sha256:${string}`
+  startedAt: number
+  endedAt: number
+}
