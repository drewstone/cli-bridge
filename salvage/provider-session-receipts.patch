+/**
+ * Hash only bytes proven to be the native provider's exact user prompt.
+ * Multipart content and synthesized multi-message transcripts remain unknown.
+ */
+function exactUserPromptSha256(
+  req: ChatRequest,
+): `sha256:${string}` | undefined {
+  if (req.messages.length !== 1) return undefined
+  const message = req.messages[0]
+  if (message?.role !== 'user' || typeof message.content !== 'string') return undefined
+  return `sha256:${createHash('sha256').update(message.content, 'utf8').digest('hex')}`
+}
