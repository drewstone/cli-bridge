+  /**
+   * Resolve one exact read-only session without scanning the session list.
+   * Omitting backend succeeds only when the external id names exactly one row.
+   */
+  getExact(externalId: string, backend?: string): ExactSessionLookup {
+    if (backend !== undefined) {
+      const session = this.get(externalId, backend)
+      if (!session) return { status: 'not-found' }
+      return {
+        status: 'found',
+        session: this.exactRecord(
+          session,
+          this.providerTurns(externalId, backend),
+          this.approvedPromptCount(externalId, backend),
+        ),
+      }
+    }
+
+    const rows = this.db.prepare(
+      'SELECT * FROM sessions WHERE external_id = ? ORDER BY backend ASC LIMIT 2',
+    ).all(externalId) as Record<string, unknown>[]
+    if (rows.length === 0) return { status: 'not-found' }
+    if (rows.length > 1) return { status: 'ambiguous' }
+    const row = rows[0]!
+    const session = this.hydrate(row)
+    return {
+      status: 'found',
+      session: this.exactRecord(
+        session,
+        this.hydrateProviderTurns(row.provider_turns_json),
+        this.approvedPromptCount(session.externalId, session.backend),
+      ),
+    }
+  }
