diff --git a/src/backends/mcp-mount.ts b/src/backends/mcp-mount.ts
new file mode 100644
index 0000000..771e87c
--- /dev/null
+++ b/src/backends/mcp-mount.ts
@@ -0,0 +1,201 @@
+/**
+ * Pluggable MCP-mount strategies — the one seam every backend uses to
+ * expose a set of MCP servers to its CLI.
+ *
+ * Each CLI loads MCP config differently: opencode layers a JSON file via
+ * the `OPENCODE_CONFIG` env var, kimi takes a `--mcp-config-file` flag,
+ * pi discovers `<cwd>/.pi/mcp.json` through the `pi-mcp-adapter`
+ * extension, codex reads `$CODEX_HOME/config.toml`. That per-vendor
+ * knowledge used to live inline in each backend's spawn path, so adding a
+ * harness meant forking a materializer AND editing that backend. This
+ * module collapses it into ONE declarative strategy per backend,
+ * registered by name. Adding a vendor is a single `register()` call — the
+ * spawn path never changes.
+ *
+ * A strategy takes the resolved MCP server map (request ∪ profile) and
+ * returns a {@link McpMount}: env vars to merge, argv flags to append, and
+ * a `cleanup()` the backend runs in its `finally`. The strategy — not the
+ * backend — owns the fail-loud decision when a caller requests servers the
+ * CLI genuinely cannot serve (pi without its adapter).
+ *
+ * Mirrors the {@link BackendRegistry} pattern (registry.ts): first-class
+ * registration, resolve-by-name, no global mutable singleton beyond the
+ * shared default registry the backends consume.
+ */
+
+import type { McpServerSpec } from './types.js'
+import { BackendError } from './types.js'
+import {
+  buildCanonicalMcpServers,
+  materializeEmptyMcpConfig,
+  materializeMcpServersForClaudeKimi,
+  materializeMcpServersForOpencode,
+  materializeMcpServersForPi,
+  piMcpAdapterAvailable,
+} from './profile-support.js'
+
+/** Everything a strategy needs to materialize a mount for one turn. */
+export interface McpMountContext {
+  /**
+   * Run working directory. cwd-native config files (pi's `.pi/mcp.json`)
+   * land here; strategies that use a temp dir ignore it.
+   */
+  cwd: string
+}
+
+/**
+ * The result of mounting MCP servers for one backend, one turn.
+ *
+ * The backend merges {@link env} into the spawned CLI's environment,
+ * appends {@link args} to its argv, and calls {@link cleanup} in its
+ * `finally` block (after the subprocess is reaped). `env`/`args` are the
+ * ONLY two injection shapes any current CLI needs — a strategy uses one,
+ * the other, or (pi) neither (it writes a cwd file instead).
+ */
+export interface McpMount {
+  /** Env vars to merge into the spawned CLI's environment (e.g. `OPENCODE_CONFIG`). */
+  readonly env: Record<string, string>
+  /** Argv flags to append when spawning the CLI (e.g. `['--mcp-config-file', path]`). */
+  readonly args: readonly string[]
+  /** Names of the servers actually mounted — for logging / assertions. */
+  readonly serverNames: readonly string[]
+  /** Tear down temp files / workspace writes. Idempotent; safe to call once. */
+  cleanup(): void
+}
+
+/**
+ * How one backend exposes a set of MCP servers to its CLI. Registered per
+ * backend in the shared {@link mcpMountRegistry}.
+ */
+export interface McpMountStrategy {
+  /** Backend name this serves — matches `Backend.name`. */
+  readonly backend: string
+  /**
+   * Materialize `specs` (the resolved request ∪ profile server map) into a
+   * mount.
+   *
+   * Return `null` when there is nothing to mount AND the backend needs no
+   * config for an empty set. MUST throw `BackendError('not_configured')`
+   * when the caller requested servers this backend genuinely cannot serve —
+   * fail loud, never silent-drop (a tool-less run that scores zero for the
+   * wrong reason is the bug this whole path exists to prevent).
+   */
+  mount(specs: Record<string, McpServerSpec> | null, ctx: McpMountContext): McpMount | null
+}
+
+/**
+ * Registry of MCP-mount strategies, keyed by backend name. One instance
+ * (the exported {@link mcpMountRegistry}) is shared by every backend;
+ * tests can build their own.
+ */
+export class McpMountRegistry {
+  private readonly strategies = new Map<string, McpMountStrategy>()
+
+  /** Register (or replace) the strategy for a backend. Last write wins. */
+  register(strategy: McpMountStrategy): this {
+    this.strategies.set(strategy.backend, strategy)
+    return this
+  }
+
+  /** The strategy for `backend`, or null when none is registered. */
+  get(backend: string): McpMountStrategy | null {
+    return this.strategies.get(backend) ?? null
+  }
+
+  /** Backend names with a registered strategy. */
+  backends(): string[] {
+    return [...this.strategies.keys()]
+  }
+
+  /**
+   * Resolve the strategy for `backend` and mount `specs`. Returns null when
+   * the backend has no registered strategy (MCP is a no-op for it) or the
+   * strategy mounts nothing. Propagates a strategy's fail-loud
+   * `BackendError` when it rejects the requested servers.
+   */
+  mount(
+    backend: string,
+    specs: Record<string, McpServerSpec> | null,
+    ctx: McpMountContext,
+  ): McpMount | null {
+    const strategy = this.strategies.get(backend)
+    if (!strategy) return null
+    return strategy.mount(specs, ctx)
+  }
+}
+
+const NO_OP_CLEANUP = (): void => {}
+
+/**
+ * opencode — the config file is layered on top of the user's global
+ * `~/.config/opencode/opencode.json` via the `OPENCODE_CONFIG` env var
+ * (opencode-cli has no per-invocation MCP flag). ALWAYS mounts, even for
+ * an empty server set, because the same file carries the headless
+ * permission map that keeps automated runs from blocking on a prompt.
+ */
+export const opencodeMcpMountStrategy: McpMountStrategy = {
+  backend: 'opencode',
+  mount(specs) {
+    const m = materializeMcpServersForOpencode(specs)
+    return {
+      env: { OPENCODE_CONFIG: m.configPath },
+      args: [],
+      serverNames: m.serverNames,
+      cleanup: m.cleanup,
+    }
+  },
+}
+
+/**
+ * kimi — a temp `mcp-config.json` (canonical claude/kimi shape, remote
+ * `{type,url,headers}` entries forwarded verbatim) passed via
+ * `--mcp-config-file`. ALWAYS passes a file (empty fallback) so the run
+ * ignores the operator's global `~/.kimi/mcp.json` and stays deterministic.
+ */
+export const kimiMcpMountStrategy: McpMountStrategy = {
+  backend: 'kimi',
+  mount(specs) {
+    const m = materializeMcpServersForClaudeKimi(specs) ?? materializeEmptyMcpConfig()
+    return {
+      env: {},
+      args: ['--mcp-config-file', m.configPath],
+      serverNames: m.serverNames,
+      cleanup: m.cleanup,
+    }
+  },
+}
+
+/**
+ * pi — pi's CLI ships no MCP support; the `pi-mcp-adapter` extension
+ * discovers `<cwd>/.pi/mcp.json`. FAIL LOUD when the adapter is absent:
+ * writing a config pi never reads would silently drop the requested tools,
+ * turning a tool-dependent run into a zero for the wrong reason. Mounts
+ * nothing (returns null) when no servers were requested.
+ */
+export const piMcpMountStrategy: McpMountStrategy = {
+  backend: 'pi',
+  mount(specs, ctx) {
+    const serverNames = specs ? Object.keys(buildCanonicalMcpServers(specs)) : []
+    if (serverNames.length === 0) return null
+    if (!piMcpAdapterAvailable()) {
+      throw new BackendError(
+        `backend pi cannot mount MCP servers: pi-mcp-adapter extension not installed `
+        + `(run \`pi install npm:pi-mcp-adapter\` or set CLI_BRIDGE_PI_MCP_ADAPTER=1); `
+        + `requested: ${serverNames.join(', ')}`,
+        'not_configured',
+      )
+    }
+    const m = materializeMcpServersForPi(specs, ctx.cwd)
+    if (!m) return null
+    return { env: {}, args: [], serverNames: m.serverNames, cleanup: m.cleanup ?? NO_OP_CLEANUP }
+  },
+}
+
+/**
+ * The shared registry every backend consumes. Adding a vendor is one
+ * `.register()` call here (or at startup) — no backend spawn-path edit.
+ */
+export const mcpMountRegistry = new McpMountRegistry()
+  .register(opencodeMcpMountStrategy)
+  .register(kimiMcpMountStrategy)
+  .register(piMcpMountStrategy)
