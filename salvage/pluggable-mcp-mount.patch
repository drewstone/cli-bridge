+describe('McpMountRegistry', () => {
+  it('resolves a registered strategy by backend name and mounts', () => {
+    const calls: string[] = []
+    const stub: McpMountStrategy = {
+      backend: 'stub',
+      mount() {
+        calls.push('mount')
+        return { env: { X: '1' }, args: ['--flag'], serverNames: ['s'], cleanup() {} }
+      },
+    }
+    const reg = new McpMountRegistry().register(stub)
+    expect(reg.get('stub')).toBe(stub)
+    expect(reg.backends()).toEqual(['stub'])
+    const m = reg.mount('stub', null, { cwd: '/tmp' })
+    expect(m?.env).toEqual({ X: '1' })
+    expect(m?.args).toEqual(['--flag'])
+    expect(calls).toEqual(['mount'])
+  })
+
+  it('returns null for an unregistered backend (MCP is a no-op there)', () => {
+    const reg = new McpMountRegistry()
+    expect(reg.mount('nope', remoteSearch, { cwd: '/tmp' })).toBeNull()
+  })
+
+  it('last register wins for a backend name', () => {
+    const a: McpMountStrategy = { backend: 'x', mount: () => null }
+    const b: McpMountStrategy = { backend: 'x', mount: () => ({ env: {}, args: ['b'], serverNames: [], cleanup() {} }) }
+    const reg = new McpMountRegistry().register(a).register(b)
