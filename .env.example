# cli-bridge configuration — copy to .env and edit.

# --- Network ---
# Default binds to 127.0.0.1 (localhost only). Override ONLY if you know
# what you're doing and have a bearer check in place (BRIDGE_BEARER).
BRIDGE_HOST=127.0.0.1
# 3344 chosen to dodge common dev/service collisions (8787, 4098, etc.)
BRIDGE_PORT=3344

# When BRIDGE_HOST is anything other than 127.0.0.1 / ::1 / localhost, the
# server REFUSES to start without BRIDGE_BEARER set.
# Generate with: openssl rand -hex 32
# BRIDGE_BEARER=

# --- Storage ---
BRIDGE_DATA_DIR=./data

# --- Backends ---
# Comma-separated. Model ids are `<harness>/<model>` — the harness name
# here is what matches the id prefix. Unknown or missing-CLI backends
# are reported by /health with state=unavailable.
#
# Harnesses:
#   claude      — Claude Code CLI, real Anthropic
#   claudish    — Claude Code CLI + claudish proxy (ANTHROPIC_BASE_URL override)
#   kimi        — Kimi Code CLI (Moonshot subscription)
#   gemini      — Gemini CLI (Google subscription/API auth)
#   sandbox     — Tangle sandbox-api + AgentProfile catalog (profiles/*.json)
#   codex       — OpenAI Codex CLI
#   opencode    — opencode CLI (multi-provider; vehicle for Kimi Code via plugin)
BRIDGE_BACKENDS=claude,kimi,gemini,sandbox

# --- Execution deadline fallback ---
# Requests own their process deadline with execution.timeoutMs. These settings
# apply only when a request omits it. Unset or 0 means no deadline.
# CLI_TIMEOUT_MS=0

# --- Host admission / process caps ---
# Outer HTTP admission cap. Requests above maxActive wait in-process up to
# queue timeout; above maxQueue fail with 503 instead of spawning more CLIs.
# BRIDGE_HOST_CHAT_MAX_ACTIVE=8
# BRIDGE_HOST_CHAT_MAX_QUEUE=16
# BRIDGE_HOST_CHAT_QUEUE_TIMEOUT_MS=30000

# Durable-run replay and idempotency retention (process-local).
# BRIDGE_RUN_MAX_REPLAY_DELTAS=10000
# BRIDGE_RUN_REPLAY_RETENTION_MS=60000
# BRIDGE_RUN_IDENTITY_RETENTION_MS=86400000
# Optional emergency cap for one unsettled run. Unset or 0 means no deadline.
# BRIDGE_RUN_MAX_LIFETIME_MS=0

# --- Traces ---
# One OTLP span per chat request (LLM span + a TOOL child per reported tool
# call), appended as JSON lines. On by default: the bridge is the only place
# every harness passes through, so tracing here covers all of them at once.
# Set BRIDGE_TRACE=off to disable.
# BRIDGE_TRACE=on
# BRIDGE_TRACE_FILE=<BRIDGE_DATA_DIR>/traces/spans.jsonl
# The active file rotates to .1, .2, … once it would exceed MAX_BYTES, and the
# oldest generation is deleted, so retained trace bytes never exceed
# MAX_BYTES × MAX_FILES — 32 MiB by default. Raise both for longer history.
# BRIDGE_TRACE_MAX_BYTES=16777216
# BRIDGE_TRACE_MAX_FILES=2
# TOOL spans per request; the observed count is reported in full regardless.
# BRIDGE_TRACE_MAX_TOOL_SPANS=512

# Raw host executor cap. Used directly by backends that cannot run in a
# systemd scope and as fallback when systemd-run is unavailable.
# BRIDGE_HOST_MAX_CONCURRENCY=4
# BRIDGE_HOST_ACQUIRE_DEADLINE_MS=60000

# Scoped host executor cap. Claude/Kimi/Pi default here on Linux: every
# CLI lives in its own transient systemd scope with cgroup memory/task/runtime
# ceilings and is killed as a whole on release. RuntimeMaxSec is an optional
# operator safety cap; unset or 0 leaves lifetime to execution.timeoutMs.
# The memory cap defaults to host RAM / 8, rounded up to a whole GiB and
# clamped to 3G..8G (8G on hosts with 64 GB or more). Any systemd MemoryMax=
# value overrides it.
# CLI_BRIDGE_SCOPE_MAX_CONCURRENCY=4
# CLI_BRIDGE_SCOPE_ACQUIRE_DEADLINE_MS=60000
# CLI_BRIDGE_SCOPE_TASKS_MAX=128
# CLI_BRIDGE_SCOPE_MEMORY_MAX=8G
# CLI_BRIDGE_SCOPE_RUNTIME_MAX_SEC=0

# --- claude / claudish ---
# CLAUDE_BIN=/usr/local/bin/claude
# CLAUDE_TIMEOUT_MS=0

# --- Per-backend executor (parallel mode via Docker pool) ---
# Every subprocess backend (claude, kimi, gemini, codex, opencode) supports an
# optional Docker executor. 'host' (default) spawns the CLI on the host.
# 'docker' provisions a pool of pre-warmed containers and dispatches
# each chat() via `docker exec` — required when serving N concurrent
# chat() calls without FS / OAuth race conditions.
#
# Local CLI execution uses the host; explicit <NAME>_EXECUTOR=host is accepted.
# BRIDGE_DEFAULT_EXECUTOR=host
# Docker executor and net-jail configuration is no longer supported.

#
# Topology note: cli-bridge itself should run as a HOST process when
# you want the executor to spawn pool containers. If you run cli-bridge
# inside a container (compose.yml), mount /var/run/docker.sock so the
# bridge can drive the host docker daemon to spawn its pool as siblings;
# see README "Parallel mode (Docker pool)".

# URL of a running claudish proxy. Only required if `claudish` is in
# BRIDGE_BACKENDS. https://github.com/MadAppGang/claudish
# CLAUDISH_URL=http://127.0.0.1:3456

# --- codex ---
# CODEX_BIN=codex
# CODEX_TIMEOUT_MS=0
# Enable codex in BRIDGE_BACKENDS for this process. CODEX_HOME selects this
# process's subscription account; unset means $HOME/.codex.
# CODEX_HOME=/path/to/this-account/codex-home

# --- opencode ---
# OPENCODE_BIN=opencode
# OPENCODE_TIMEOUT_MS=0

# --- kimi ---
# KIMI_BIN=kimi
# KIMI_TIMEOUT_MS=0

# --- gemini ---
# Install official package only: npm install -g @google/gemini-cli
# GEMINI_BIN=gemini
# GEMINI_TIMEOUT_MS=0
# GEMINI_APPROVAL_MODE=yolo
# GEMINI_SANDBOX=false

# --- pi ---
# PI_BIN=pi
# PI_TIMEOUT_MS=0

# --- Sandbox ---
# SANDBOX_API_URL=https://sandbox.tangle.tools
# SANDBOX_API_KEY=
# SANDBOX_PROFILES_DIR=./profiles
# SANDBOX_TIMEOUT_MS=0

# --- Native provider keys (only for harnesses configured for API auth) ---
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# MOONSHOT_API_KEY=
# ZAI_API_KEY=

# --- /cad/render (OpenSCAD → STL/PNG/GLB) ---
# Wall-clock budget for a single render (default 60_000 ms). Covers
# stl + png + glb steps combined.
# CAD_RENDER_TIMEOUT_MS=60000
# Requires `openscad` on $PATH (hardware profile in agent-container).
# GLB output additionally requires `python3` + `trimesh`; if absent, GLB
# is omitted with a warning rather than failing the request.

# --- /v1/images/generations (OpenAI-compatible image gen) ---
# Default model: gpt-image-2. OpenAI-shaped body forwarded verbatim to
# upstream, OpenAI-shaped response returned to caller. Dispatch:
#   1. TANGLE_API_KEY set → forward to ${TANGLE_ROUTER_URL or
#      https://router.tangle.tools/v1}/images/generations
#   2. else OPENAI_API_KEY set → forward to https://api.openai.com/v1/...
#   3. else → 503 no_image_backend
# Override the router base for staging tangle-router instances:
# TANGLE_ROUTER_URL=https://router-staging.tangle.tools/v1
